{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Used Car Price Prediction Request",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manufacture_year",
    "listed_year",
    "mileage",
    "fuel_type",
    "transmission",
    "origin",
    "engine_size",
    "seat_count"
  ],
  "properties": {
    "brand": {
      "type": "string",
      "description": "Vehicle brand, optional for regression_v1 but useful for downstream display and future models.",
      "example": "Toyota"
    },
    "model": {
      "type": "string",
      "description": "Vehicle model, optional for regression_v1 but useful for downstream display and future models.",
      "example": "Vios"
    },
    "manufacture_year": {
      "type": "integer",
      "minimum": 1990,
      "description": "Vehicle production year.",
      "example": 2021
    },
    "listed_year": {
      "type": "integer",
      "minimum": 1990,
      "description": "Year when listing was observed. Used to compute vehicle_age.",
      "example": 2026
    },
    "listed_month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "Month when listing was observed. Optional in regression_v1.",
      "example": 9
    },
    "mileage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Odometer value in kilometers.",
      "example": 45000
    },
    "fuel_type": {
      "type": "string",
      "enum": ["Gasoline", "Diesel", "Hybrid", "Electric"],
      "description": "Normalized fuel type.",
      "example": "Gasoline"
    },
    "transmission": {
      "type": "string",
      "enum": ["Automatic", "Manual", "CVT"],
      "description": "Normalized transmission type.",
      "example": "Automatic"
    },
    "origin": {
      "type": "string",
      "enum": ["Domestic", "Imported"],
      "description": "Vehicle origin.",
      "example": "Domestic"
    },
    "engine_size": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Engine displacement in liters. Electric vehicles should use 0.",
      "example": 1.5
    },
    "seat_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 60,
      "description": "Number of seats.",
      "example": 5
    },
    "price": {
      "type": "number",
      "minimum": 50000000,
      "maximum": 15000000000,
      "description": "Observed listing price in VND. Required for training data, not required for prediction."
    },
    "crawled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when TV3 crawler observed the listing."
    }
  }
}
